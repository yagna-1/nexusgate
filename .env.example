# NexusGate Configuration
# Copy this to .env and fill in your values

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# ── LLM Provider Keys (set at least one) ────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ── Optional Overrides ───────────────────────────────────────────────────────
# PORT=8080
# DEFAULT_MAX_TOKENS=4096
# REQUEST_TIMEOUT_SECS=60
# MAX_FALLBACK_ATTEMPTS=3
# MCP_UPSTREAM_URL=http://astragraph-proxy:7070
# MCP_UPSTREAM_BEARER_TOKEN=
# MCP_DEFAULT_ESTIMATED_COST_MICRO_USD=2500
# PUBLIC_BASE_URL=http://localhost:8080
# RUST_LOG=nexusgate=debug
